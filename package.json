{
  "name": "@talking-head-dev/widget",
  "version": "0.1.0",
  "description": "An embeddable 3D talking head for any website, playing clips made in the talking-head.dev studio.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "docs", "README.md", "THIRD_PARTY_NOTICES.md"],
  "exports": {
    ".": {
      "talking-head-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/widget.js"
    },
    "./head": {
      "talking-head-source": "./src/head.ts",
      "types": "./dist/types/head.d.ts",
      "default": "./dist/head.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && vite build --mode iife",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "web-head": "node scripts/web-head.mjs",
    "demo": "node demo/serve.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "jsdom": "^30.0.1",
    "meshoptimizer": "^0.25.0",
    "oxlint": "^1.88.0",
    "sharp": "^0.34.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
